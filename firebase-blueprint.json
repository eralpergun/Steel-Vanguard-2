{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Player progress and stats",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "totalCoins": { "type": "number" },
        "unlockedTanks": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["username", "totalCoins", "unlockedTanks"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Entry in the global leaderboard",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "score": { "type": "number" }
      },
      "required": ["username", "score"]
    }
  },
  "firestore": {
    "/players/{username}": {
      "schema": { "$ref": "Player" },
      "description": "Player data"
    },
    "/leaderboard/{username}": {
      "schema": { "$ref": "LeaderboardEntry" },
      "description": "Leaderboard data"
    }
  }
}
