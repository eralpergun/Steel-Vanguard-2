rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: players
    // Document ID: username (string)
    // Fields:
    //   - username: string (required)
    //   - totalCoins: number (required, >= 0)
    //   - unlockedTanks: list (required, strings)
    //
    // Collection: leaderboard
    // Document ID: username (string)
    // Fields:
    //   - username: string (required)
    //   - score: number (required, >= 0)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "eralpergun06@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidPlayer(data) {
      return hasRequiredFields(['username', 'totalCoins', 'unlockedTanks']) &&
             hasOnlyAllowedFields(['username', 'totalCoins', 'unlockedTanks']) &&
             data.username is string && data.username.size() > 0 && data.username.size() < 50 &&
             data.totalCoins is number && data.totalCoins >= 0 &&
             data.unlockedTanks is list;
    }

    function isValidLeaderboardEntry(data) {
      return hasRequiredFields(['username', 'score']) &&
             hasOnlyAllowedFields(['username', 'score']) &&
             data.username is string && data.username.size() > 0 && data.username.size() < 50 &&
             data.score is number && data.score >= 0;
    }

    match /players/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPlayer(request.resource.data);
      allow update: if isAuthenticated() && isValidPlayer(request.resource.data);
      allow delete: if isAdmin();
    }

    match /leaderboard/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidLeaderboardEntry(request.resource.data);
      allow update: if isAuthenticated() && isValidLeaderboardEntry(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
